#!/usr/bin/env python3
"""Free dictation's VRAM when other apps need the GPU.

Every few seconds, measures VRAM used by everything except dictation
(Ollama and Voxtype). When that passes PAUSE_AT, it unloads the cleanup model,
drops a flag file, and, as soon as no dictation is running, restarts Voxtype
on its CPU build, freeing all of dictation's VRAM. While the flag exists,
dictation-record skips warming the model and dictation-live, and
dictation-cleanup passes Cohere's text through untouched (still punctuated,
replacements still applied). Once other usage stays below RESUME_AT for
RESUME_AFTER seconds, the flag is removed, Voxtype moves back to the GPU,
and cleanup returns on the next dictation.

Tuned on an RTX 5080 with 16GB. The desktop idles around 0.7GB, while dictation holds
about 9.1GB: Voxtype's Cohere model on CUDA (4.4GB, loaded while on the GPU)
plus the cleanup model (4.7GB, unloaded after 10 idle minutes). Other apps
using 5GB+ (on 16GB; see DEFAULT_PAUSE) means a game, video/AI generation, or another local model; once
dictation steps aside they get up to about 15GB.
"""
import os
import subprocess
import sys
import time
import urllib.request

GIB = 1024  # nvidia-smi reports MiB


def total_vram_gib():
    try:
        out = subprocess.run(["nvidia-smi", "--query-gpu=memory.total", "--format=csv,noheader,nounits"],
                             capture_output=True, text=True, timeout=5).stdout.split()
        return int(out[0]) / GIB
    except (OSError, subprocess.SubprocessError, ValueError, IndexError):
        return 16.0


def voxtype_uses_gpu():
    """False when install.sh put Voxtype on the CPU for good (cards under 12GB)."""
    try:
        return "cuda" in open(os.path.expanduser("~/.config/voxtype/omavoice.env")).read()
    except OSError:
        return True


# Dictation needs about 9GB (4.7GB when Voxtype runs on the CPU) plus 2GB of
# headroom, so step aside once other apps use more than what is left: 5GB on
# a 16GB card. Resume once they drop 1.5GB below that, never below 1GB, which
# the desktop alone can use.
DEFAULT_PAUSE = max(2.0, round(total_vram_gib() - (11 if voxtype_uses_gpu() else 6.7), 1))
PAUSE_AT = float(os.environ.get("DICTATION_VRAM_PAUSE_GIB", DEFAULT_PAUSE)) * GIB
RESUME_AT = float(os.environ.get("DICTATION_VRAM_RESUME_GIB", max(1.0, DEFAULT_PAUSE - 1.5))) * GIB
RESUME_AFTER = int(os.environ.get("DICTATION_VRAM_RESUME_AFTER", 60))
POLL = 3
MODEL = os.environ.get("DICTATION_MODEL", "gemma4:e4b")
RUNTIME = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
FLAG = os.path.join(RUNTIME, "voxtype", "gpu-busy")
VOXTYPE_STATE = os.path.join(RUNTIME, "voxtype", "state")
# Read by the voxtype.service drop-in; while it exists Voxtype runs its CPU
# build, which holds no VRAM. Transcription stays faster than speech there
# (about 2s per 20s chunk), so dictation keeps working, only without cleanup.
VARIANT_ENV = os.path.join(RUNTIME, "voxtype-variant.env")
CPU_BIN = "/usr/lib/voxtype/voxtype-onnx-avx2"


def other_vram_mib():
    total = subprocess.run(["nvidia-smi", "--query-gpu=memory.used", "--format=csv,noheader,nounits"],
                           capture_output=True, text=True, timeout=5).stdout.split()
    apps = subprocess.run(["nvidia-smi", "--query-compute-apps=process_name,used_memory",
                           "--format=csv,noheader,nounits"], capture_output=True, text=True, timeout=5).stdout
    # Dictation's own usage (the cleanup model and Voxtype's GPU transcriber) doesn't count.
    dictation = sum(int(line.rsplit(",", 1)[1]) for line in apps.splitlines()
                    if any(n in line.rsplit(",", 1)[0] for n in ("ollama", "voxtype")))
    return int(total[0]) - dictation


def unload():
    body = f'{{"model":"{MODEL}","keep_alive":0}}'.encode()
    try:
        urllib.request.urlopen(urllib.request.Request("http://127.0.0.1:11434/api/generate", data=body,
                                                      headers={"Content-Type": "application/json"}), timeout=10).read()
    except OSError:
        pass


def voxtype_idle():
    try:
        return open(VOXTYPE_STATE).read().strip() == "idle"
    except OSError:
        return False


def move_voxtype(to_cpu):
    """Restart Voxtype on the CPU or GPU build. Only called while it is idle,
    so no dictation is cut off; one started during the few seconds of the
    restart would not be picked up."""
    if to_cpu:
        with open(VARIANT_ENV, "w") as f:
            f.write(f"VOXTYPE_BIN={CPU_BIN}\n")
    else:
        os.remove(VARIANT_ENV)
    subprocess.run(["systemctl", "--user", "restart", "voxtype.service"], check=False, timeout=60)


def notify(msg):
    subprocess.run(["notify-send", "-u", "low", "-a", "Dictation", "Dictation", msg], check=False)


def main():
    os.makedirs(os.path.dirname(FLAG), exist_ok=True)
    busy = os.path.exists(FLAG)
    calm_since = None
    while True:
        try:
            other = other_vram_mib()
        except (OSError, subprocess.TimeoutExpired, ValueError, IndexError):
            time.sleep(POLL)
            continue
        if not busy and other >= PAUSE_AT:
            open(FLAG, "w").close()
            unload()
            busy, calm_since = True, None
            notify(f"GPU busy ({other / GIB:.1f}GB in use): dictation moves to the CPU and skips cleanup.")
        elif busy:
            if other >= PAUSE_AT:
                unload()  # keep it out even if something reloaded it while paused
            if other < RESUME_AT:
                calm_since = calm_since or time.monotonic()
                if time.monotonic() - calm_since >= RESUME_AFTER:
                    os.remove(FLAG)
                    busy = False
                    notify("GPU free again: dictation is back on the GPU with cleanup.")
            else:
                calm_since = None
        # Voxtype follows the busy state, switching only between dictations.
        if os.path.exists(VARIANT_ENV) != busy and voxtype_idle():
            move_voxtype(busy)
        time.sleep(POLL)


if __name__ == "__main__":
    sys.exit(main())
