#!/usr/bin/env python3
"""Weekly review of likely mishearings in your dictations.

Usage:
  omavoice-dictionary-review run       scan the last week, then open the review
                                       window (what the Sunday timer runs)
  omavoice-dictionary-review scan      only scan and save suggestions
  omavoice-dictionary-review review    approve or skip the saved suggestions
  omavoice-dictionary-review list      print the saved suggestions

Approving adds the right spelling to ~/.config/voxtype/dictionary.txt with a
`misheard as "X"` hint, and optionally an exact word replacement in
config.toml (then Voxtype restarts once it is idle). Nothing leaves this
machine: the scan uses your local history and the local cleanup model.
"""
import os
import shutil
import subprocess
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import omavoice_review as review  # noqa: E402

ADD_REPLACE = "Fix it: dictionary + always replace the heard words"
ADD = "Add to dictionary only (cleanup decides from context)"
SKIP = "Skip for now"
NEVER = "Never suggest this again"


def notify(title, body):
    subprocess.run(["notify-send", "-a", "omavoice", "-i", "accessories-dictionary", title, body],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5, check=False)


def gum(*args, input_text=None):
    r = subprocess.run(["gum", *args], input=input_text, text=True, stdout=subprocess.PIPE)
    if r.returncode == 130:
        raise KeyboardInterrupt
    return r.stdout.strip()


def restart_voxtype_when_idle(limit=120):
    state = os.path.join(os.environ.get("XDG_RUNTIME_DIR", ""), "voxtype", "state")
    for _ in range(limit):
        try:
            if open(state).read().strip() == "idle":
                subprocess.run(["systemctl", "--user", "restart", "voxtype"], check=False)
                return True
        except OSError:
            pass
        time.sleep(1)
    return False


def do_review():
    items = review.pending()
    if not items:
        print("No suggestions waiting. Run: omavoice-dictionary-review scan")
        return 0
    use_gum = shutil.which("gum") and sys.stdin.isatty()
    replaced = added = 0
    print(f"{len(items)} possible mishearings from your dictations this week.\n")
    try:
        for n, s in enumerate(items, 1):
            print(f"[{n}/{len(items)}]  heard \"{s['heard']}\"  ->  {s['term']}"
                  + ("" if s.get("in_dictionary") else "  (new term)") + f"   seen {s.get('count', 1)}x")
            if s.get("context"):
                print(f"    {s['context']}")
            if s.get("why"):
                print(f"    why: {s['why']}")
            if use_gum:
                choice = gum("choose", ADD_REPLACE, ADD, SKIP, NEVER)
            else:
                choice = {"r": ADD_REPLACE, "a": ADD, "n": NEVER}.get(
                    input("    [r] fix + replace  [a] dictionary only  [s] skip  [n] never: ").strip().lower(), SKIP)
            if choice in (ADD_REPLACE, ADD):
                line = review.add_to_dictionary(s["term"], s["heard"])
                added += 1
                print(f"    dictionary: {line}")
                if choice == ADD_REPLACE:
                    try:
                        if review.add_replacement(s["heard"], s["term"]):
                            replaced += 1
                            print(f"    replacement: \"{s['heard'].lower()}\" -> \"{s['term']}\"")
                    except (OSError, ValueError) as e:
                        print(f"    replacement not added ({e}); the dictionary entry still helps")
            elif choice == NEVER:
                review.ignore(s)
            print()
    except (KeyboardInterrupt, EOFError):
        print("\nStopped; the rest stay for next time.")
        return 0
    review.clear_pending()
    if replaced:
        print("Restarting Voxtype for the new replacements (waits until you are not dictating)...")
        if not restart_voxtype_when_idle():
            print("Voxtype was busy; the replacements apply after: systemctl --user restart voxtype")
    print(f"Done: {added} added to the dictionary, {replaced} replacements.")
    return 0


def main(args):
    cmd = args[0] if args else "review"
    if cmd in ("scan", "run"):
        items = review.scan()
        print(f"{len(items)} suggestions")
        if cmd == "run":
            if not items:
                notify("Dictionary review", "No likely mishearings in this week's dictations.")
                return 0
            launcher = shutil.which("omarchy-launch-floating-terminal-with-presentation")
            me = os.path.realpath(__file__)
            if launcher:
                subprocess.Popen([launcher, f"{me} review"], start_new_session=True)
            else:
                notify("Dictionary review", f"{len(items)} possible mishearings. Run: omavoice-dictionary-review review")
        return 0
    if cmd == "review":
        return do_review()
    if cmd == "list":
        for s in review.pending():
            print(f"{s['kind']:5}  \"{s['heard']}\" -> {s['term']}  ({s.get('count', 1)}x)  {s.get('context', '')}")
        return 0
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
