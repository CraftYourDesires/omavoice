#!/usr/bin/env python3
"""Clean a long dictation while you are still talking.

Voxtype transcribes 20s eager chunks during recording, but only hands the text
to dictation-cleanup after the key is released, so a long dictation used to
wait for the LLM to rewrite everything at the end. dictation-record starts
this helper with each recording. It follows Voxtype's debug log (the daemon
logs "Chunk N completed: <text>" to $XDG_RUNTIME_DIR/voxtype-daemon.log, which
lives in RAM), rebuilds the transcript exactly the way Voxtype stitches chunks,
and cleans every finished sentence as soon as it is known. The last sentence
of each chunk is held back because the chunk cut usually lands mid-sentence.

Results go to $XDG_RUNTIME_DIR/voxtype/live.json. dictation-cleanup then only
cleans what is left after the last pre-cleaned sentence, and falls back to a
full cleanup whenever the pieces don't line up. Transcripts never leave RAM:
the log is truncated at every recording start and live.json is deleted after
use.
"""
import importlib.machinery
import importlib.util
import json
import os
import re
import sys
import time

RUNTIME_ROOT = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
RUNTIME = os.path.join(RUNTIME_ROOT, "voxtype")
DAEMON_LOG = os.path.join(RUNTIME_ROOT, "voxtype-daemon.log")
STATE = os.path.join(RUNTIME, "live.json")
STOP = os.path.join(RUNTIME, "live.stop")
PID = os.path.join(RUNTIME, "live.pid")
VOXTYPE_STATE = os.path.join(RUNTIME, "state")
MAX_SECONDS = 11 * 60  # Voxtype caps recordings at 10 minutes.

CHUNK_LINE = re.compile(r'Chunk (\d+) completed(?: \(waited\))?: (".*")\s*$')
ANSI = re.compile(r"\x1b\[[0-9;]*m")
MAX_SEAM_WORDS = 6


def load_cleanup():
    sys.dont_write_bytecode = True  # keep ~/.local/bin free of __pycache__
    # Next to this script (through the ~/.local/bin symlink, the repo copy).
    here = os.path.dirname(os.path.realpath(__file__))
    loader = importlib.machinery.SourceFileLoader(
        "dictation_cleanup", os.path.join(here, "dictation-cleanup"))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def rust_debug_string(quoted):
    """Decode a Rust {:?} string literal as printed by Voxtype's logger."""
    body = quoted[1:-1]
    body = re.sub(r"\\u\{([0-9a-fA-F]+)\}", lambda m: chr(int(m.group(1), 16)), body)
    escapes = {"n": "\n", "t": "\t", "r": "\r", "0": "\0", "\\": "\\", '"': '"', "'": "'"}
    return re.sub(r"\\(.)", lambda m: escapes.get(m.group(1), m.group(1)), body)


def deduplicate_boundary(previous, new_text):
    """Port of voxtype 1.0.1 src/eager.rs deduplicate_boundary, kept exact."""
    prev_words, new_words = previous.split(), new_text.split()
    if not prev_words or not new_words:
        return new_text
    best = 0
    for n in range(1, min(len(prev_words), len(new_words)) + 1):
        if all(a.lower() == b.lower() for a, b in zip(prev_words[-n:], new_words[:n])):
            best = n
    return " ".join(new_words[best:]) if best else new_text


def seam_repeats(previous_words, new_words):
    """How many leading new_words repeat the end of previous_words, ignoring
    case and punctuation. Voxtype's own dedup compares punctuation too, so
    "Lionel." at the end of one chunk and "Lionel Giles" at the start of the
    next both survive into its transcript."""
    norm = lambda w: re.sub(r"[^a-z0-9]", "", w.lower())
    best = 0
    for n in range(1, min(MAX_SEAM_WORDS, len(previous_words), len(new_words)) + 1):
        tail, head = [norm(w) for w in previous_words[-n:]], [norm(w) for w in new_words[:n]]
        if all(tail) and tail == head:
            best = n
    return best


def voxtype_state():
    try:
        return open(VOXTYPE_STATE).read().strip()
    except OSError:
        return ""


def write_state(state):
    tmp = STATE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(state, f)
    os.replace(tmp, STATE)


def main():
    os.makedirs(RUNTIME, exist_ok=True)
    # One session at a time: a new recording replaces any leftover helper.
    try:
        old = int(open(PID).read())
        if old != os.getpid():
            os.kill(old, 15)
    except (OSError, ValueError):
        pass
    with open(PID, "w") as f:
        f.write(str(os.getpid()))
    for p in (STATE, STOP):
        try:
            os.remove(p)
        except OSError:
            pass
    # Start each recording with an empty log so old transcripts don't linger.
    try:
        open(DAEMON_LOG, "w").close()
    except OSError:
        return

    cleanup = load_cleanup()
    if cleanup.settings().get("cleanup") is False:
        return
    cls, title = cleanup.focused_window()
    style = cleanup.pick_style(cls, title)
    context = cleanup.screen_context(cls, [])
    state = {"started": time.time(), "busy": False, "segments": []}
    write_state(state)

    chunks = {}          # chunk index -> raw text
    next_index = 0       # next chunk to stitch in order
    combined = ""        # Voxtype's stitched transcript so far
    # Words not yet cleaned, as [word, is_seam_repeat]. Every word counts
    # toward the raw text (which must match Voxtype's transcript), but seam
    # repeats are left out of what the LLM sees.
    pending = []
    cleaned_so_far = ""
    seen_recording = False
    idle_since = None
    started = time.monotonic()
    log = open(DAEMON_LOG, encoding="utf-8", errors="replace")

    while time.monotonic() - started < MAX_SECONDS:
        if not os.path.exists(STATE):
            break  # dictation-cleanup consumed the session
        for line in log.readlines():
            m = CHUNK_LINE.search(ANSI.sub("", line))
            if m:
                chunks[int(m.group(1))] = rust_debug_string(m.group(2))

        # Stitch newly finished chunks in order, exactly like Voxtype does.
        while next_index in chunks:
            text = chunks.pop(next_index)
            new = text if next_index == 0 else deduplicate_boundary(combined, text)
            if new:
                new_words = new.split()
                repeats = seam_repeats(combined.split(), new_words) if combined else 0
                pending += [[w, i < repeats] for i, w in enumerate(new_words)]
                combined = (combined + " " + new).strip() if combined else text
            next_index += 1

        # Clean everything up to the last sentence end, except the final
        # sentence, which the chunk cut usually leaves unfinished.
        cut = None
        for i, (word, _) in enumerate(pending[:-1]):
            if word[-1] in ".?!":
                cut = i + 1
        if cut and not os.path.exists(STOP):
            piece, pending = pending[:cut], pending[cut:]
            raw_piece = " ".join(w for w, _ in piece)
            llm_piece = " ".join(w for w, repeat in piece if not repeat)
            state["busy"] = True
            write_state(state)
            out = cleanup.guarded_clean(llm_piece, style, context, previous=cleaned_so_far[-400:],
                                        continuation=bool(cleaned_so_far))
            state["segments"].append({"raw": raw_piece, "clean": out})
            cleaned_so_far = cleanup.join_pieces([(s["raw"], s["clean"]) for s in state["segments"]])
            state["busy"] = False
            if os.path.exists(STATE):
                write_state(state)
            continue

        # Leave once Voxtype is idle again after the recording.
        status = voxtype_state()
        if status == "recording":
            seen_recording = True
        if status == "idle" and (seen_recording or time.monotonic() - started > 5):
            idle_since = idle_since or time.monotonic()
            if time.monotonic() - idle_since > 3:
                break
        else:
            idle_since = None
        time.sleep(0.1)

    for p in (STATE, STOP, PID):
        try:
            os.remove(p)
        except OSError:
            pass


if __name__ == "__main__":
    sys.exit(main())
